+/* -H: write a decimal floating constant as the hexadecimal one with the same
+ * value, 0x1.hhhhhhhhhhhhhp+d (0x0.hhhhhhhhhhhhhp-1022 for zero and the
+ * denormals), for a compiler with no room for atof (bcc-cc1 on an 8086).
+ * strtod rounds correctly, so this is the double the constant stands for.
+ * Text that is not all one constant is left for the compiler to report. */
+void
+hexfloat(s)
+char *s;
+{
+   union { double d; unsigned short w[4]; } u;
+   char *end;
+   int e;
+   extern double strtod();	/* stdlib.h is only for __STDC__ here */
+
+   u.d = strtod(s, &end);
+   if (*end)
+      return;
+   e = (u.w[3] >> 4) & 0x7FF;
+   sprintf(s, "0x%d.%x%04x%04x%04xp%d", e != 0, u.w[3] & 0xF,
+	   u.w[2], u.w[1], u.w[0], e ? e - 1023 : -1022);
+}
