 		{
 		    float val = *target->offset.offd;
-		    push(constsym( ((unsigned short*) &val)[1] ));
-		    push(constsym( ((unsigned short*) &val)[0] ));
+		    push(constsym((value_t) ((unsigned short*) &val)[1]));
+		    push(constsym((value_t) ((unsigned short*) &val)[0]));
 		}
 		else
 		{
-		    push(constsym(((unsigned short*) target->offset.offd)[3]));
-		    push(constsym(((unsigned short*) target->offset.offd)[2]));
-		    push(constsym(((unsigned short*) target->offset.offd)[1]));
-		    push(constsym(((unsigned short*) target->offset.offd)[0]));
+		    push(constsym((value_t) ((unsigned short*) target->offset.offd)[3]));
+		    push(constsym((value_t) ((unsigned short*) target->offset.offd)[2]));
+		    push(constsym((value_t) ((unsigned short*) target->offset.offd)[1]));
+		    push(constsym((value_t) ((unsigned short*) target->offset.offd)[0]));
 		}
 	    }
 	}
