+#ifndef NOFLOAT
+/* A hexadecimal floating constant, in the form cpp -H writes decimal ones
+ * in: 0x1.hhhhhhhhhhhhhp+d, or 0x0.hhhhhhhhhhhhhp-1022 for zero and the
+ * denormals; it gives the double's bits directly, and the 8086 compiler
+ * has no room for atof */
+PRIVATE void hexfloat(p)
+register char *p;
+{
+    union { double d; unsigned short w[4]; } u;
+    register int d;
+    int n;
+    int e;
+    int lead;
+
+    constant.type = dtype;
+    sym = FLOATCONST;
+    u.w[3] = u.w[2] = u.w[1] = u.w[0] = 0;
+    lead = *p++ - '0';
+    if ((unsigned) lead > 1 || *p++ != '.')
+	goto bad;
+    for (n = 12; n >= 0; --n)	/* the fraction's nibbles, top one first */
+    {
+	if ((d = *p++) > '9')
+	    d = (d | 0x20) - ('a' - 10);
+	else
+	    d -= '0';
+	if ((unsigned) d > 15)
+	    goto bad;
+	u.w[n >> 2] |= d << ((n & 3) << 2);
+    }
+    if ((*p++ | 0x20) != 'p')
+	goto bad;
+    e = atoi(p) + 1022 + lead;	/* the biased exponent: 0 for 0x0. */
+    if (*p == '+' || *p == '-')
+	++p;
+    while (*p >= '0' && *p <= '9')
+	++p;
+    if ((unsigned) e > 0x7FF || (e != 0) != lead)
+	goto bad;
+    u.w[3] |= e << 4;
+    constant.value.d = u.d;
+    if (*p == 'F' || *p == 'f')
+    {
+	++p;
+	constant.type = fltype;
+	constant.value.d = (float) constant.value.d;
+    }
+    if (*p == 0)
+	return;
+bad:
+    error("bad hexadecimal floating point constant");
+}
+#endif
