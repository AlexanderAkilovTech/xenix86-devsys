@@ -0,0 +1,19 @@
+# rules.mc - for code compiled with callersaves (bcc-cc1 -c, as bcc -Mc and
+# cc -Mc ask for): the caller keeps nothing in SI across a call to a C
+# function, so popping the arguments into SI does what adjusting SP does,
+# in fewer bytes. Calls to C functions (_name) only: code relies on the
+# compiler's own helpers (laddl and the others) keeping SI.
+
+call	_%1
+inc	sp
+inc	sp
+=
+call	_%1
+pop	si
+
+call	_%1
+add	sp,*4
+=
+call	_%1
+pop	si
+pop	si
